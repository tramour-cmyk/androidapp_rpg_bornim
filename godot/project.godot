; 348.6: Chroniken von Bornim in Godot (Umzug, LISTE-UMZUG-348.md); Look aus der Probe Build 11
config_version=5

[application]
config/name="Chroniken von Bornim"
run/main_scene="res://spiel.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false

[autoload]

; 399.3 (Jerry): Musik und Klang wie im alten Spiel (klang/klang.gd)
Klang="*res://klang/klang.gd"

[debug]

; 399.1 Gerät: die letzten Fehlermeldungen aus dem Protokoll (messung.gd), auch am Handy
file_logging/enable_file_logging=true

[display]
window/size/viewport_width=1080
window/size/viewport_height=2340
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; 399.1 (Chef 28.10., 14:38; DESIGN-STIL.md „Oberfläche“, 292.3): eine Schrift ueberall, Alegreya
theme/custom_font="res://kampf/schrift/alegreya_regular.ttf"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
; 348.5: ohne MSAA, sonst liefert der Mobile-Renderer der Tusche keine Tiefe (Build 10: Tusche am Handy unsichtbar)
anti_aliasing/quality/screen_space_aa=1
