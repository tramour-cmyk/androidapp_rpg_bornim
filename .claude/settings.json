{
  "env": {
    "TZ": "Europe/Berlin",
    "GIT_AUTHOR_NAME": "tramour",
    "GIT_AUTHOR_EMAIL": "tramour@gmail.com",
    "GIT_COMMITTER_NAME": "tramour",
    "GIT_COMMITTER_EMAIL": "tramour@gmail.com"
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git merge-tree:*)",
      "mcp__claude-code-remote__archive_session"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git rebase:*)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Project workflow (Chroniken von Bornim): team sessions routinely fetch origin/main and merge it into their own claude/* working branches, and check for conflicts with git merge-tree or git diff; these are expected and not merges without review. A pull request into main is merged only after the project owner has tested the build; that approval is recorded in docs/VORGANGSARCHIV.md or the team's docs/ARBEIT-*.md file on main. Notes (CLAUDE.md, CHANGELOG.md, docs/) are committed and pushed directly to main by design.",      "Ford (Betriebsleiter) archives old sessions of this account every hour with archive_session when tools/lauf.py prints an ARCHIVIERE line; this is intended by the project owner (decision 273) and is not interference with other work."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && \"$CLAUDE_PROJECT_DIR\"/tools/setup-session.sh --warm || true"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/neustart-haken.py start 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/neustart-haken.py prompt 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/weiter-haken.py 2>/dev/null; true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=/home/user/bornim-main/tools/zug-haken.py; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR\"/tools/zug-haken.py; command -v python3 >/dev/null && python3 \"$f\" 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
