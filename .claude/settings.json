{
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git merge-tree:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && \"$CLAUDE_PROJECT_DIR\"/tools/setup-session.sh --warm || true"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/neustart-haken.py start 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/neustart-haken.py prompt 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null && python3 \"$CLAUDE_PROJECT_DIR\"/tools/weiter-haken.py 2>/dev/null; true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=/home/user/bornim-main/tools/zug-haken.py; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR\"/tools/zug-haken.py; command -v python3 >/dev/null && python3 \"$f\" 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
