#!/usr/bin/env bash
# Ein Einstieg für alle Prüfungen, je Anlass das schnellste passende Werkzeug (siehe docs/LISTE-BAUEN-TESTEN.md).
# Aufruf im Hauptordner: tools/t <befehl> …   (ohne Befehl: diese Übersicht)
# 882.2: ohne Kotlin; Kerntest ist der Godot-Logiksatz (godot/tests/logik.txt), Bilder und Filme kommen aus godot.yml.
cd "$(dirname "$0")/.." || exit 1
stamp() { TZ=Europe/Berlin date "+%d.%m., %H:%M"; }
timed() { local t0; t0=$(date +%s); "$@"; local rc=$?; echo "($(( $(date +%s) - t0 )) s, fertig $(stamp))"; return $rc; }

case "$1" in
logik)
    # Godot-Logiksatz, mit Muster nur die passenden Tests: tools/t logik brs
    [ -x ~/godot/godot ] || tools/setup-session.sh >/dev/null
    if [ -n "$2" ]; then timed python3 tools/godot/logik.py "$2"; else
        timed python3 tools/godot/logik.py; rc=$?
        # Kerntest-Marke (192.3): vollständiger Lauf mit Exit 0; der Commit-Haken warnt, wenn Code neuer ist als die Marke
        [ $rc -eq 0 ] && touch "$(git rev-parse --git-common-dir)/kerntest-ok"
        exit $rc
    fi ;;
pruef|check)
    timed tools/check-env.sh --full ;;
*)
    cat <<'EOF'
tools/t <befehl>, je Anlass:

  Anlass                               Befehl                               Dauer
  Regel, Wert, Ablauf, Bedienung       tools/t logik [Muster]               etwa 2 min (mit Muster Sekunden)
  Umgebung in Ordnung?                 tools/t pruef                        etwa 2 min
  Messung mit Kaufmodellen             tools/godot/bau_am_rechner.py        Minuten (siehe Kopf der Datei)
  Bild, Film, Gesamteindruck           Zweig pushen, godot.yml              Minuten, Bild auf Telegram
EOF
    ;;
esac
